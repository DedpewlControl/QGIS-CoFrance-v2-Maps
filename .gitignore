*.sqlite3-journal
*.sqlite3.lock
*.sqlite3-lck

*.db-wal
*.db-shm
*.db-journal
*.db.lock
*.db-lck

# QGIS auxiliary database transaction files
*.qgd-wal
*.qgd-shm
*.qgd-journal

