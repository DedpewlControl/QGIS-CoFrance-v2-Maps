*.qgd~
*.qgs.bak
*.qgz.bak
*.qgd.bak
*.qgs.tmp
*.qgz.tmp
*.qgd.tmp
*.qlr~
*.qml~

# ============================================================
# GeoPackage temporary and transaction files
# Keep the actual *.gpkg files tracked
# ============================================================

*.gpkg-wal
*.gpkg-shm
*.gpkg-journal
*.gpkg.lock
*.gpkg-lck
*.gpkg.tmp
*.gpkg.temp
*.gpkg~
